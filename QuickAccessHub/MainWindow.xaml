<Window x:Class="QuickAccessHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Access Hub" Height="640" Width="700"
        MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Sharp Obsidian Dark Theme -->
        <SolidColorBrush x:Key="BgDark" Color="#0F0F17"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#161622"/>
        <SolidColorBrush x:Key="CardBg" Color="#181826"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2A2A3D"/>
        <SolidColorBrush x:Key="InputBg" Color="#222234"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextMain" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="WarningRed" Color="#EF4444"/>

        <!-- Custom Scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgDark}" CornerRadius="8" BorderBrush="{StaticResource CardBorder}" BorderThickness="1.5" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header & Search -->
                <RowDefinition Height="Auto"/> <!-- Category Filter Bar -->
                <RowDefinition Height="*"/>    <!-- Items List -->
                <RowDefinition Height="Auto"/> <!-- Drag Footer -->
            </Grid.RowDefinitions>

            <!-- Header & Movable Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Movable Title Header Bar -->
                <Border Grid.Row="0" Background="{StaticResource HeaderBg}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll" ToolTip="Click and drag to move window">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="QUICK ACCESS HUB" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Drag Hint -->
                        <TextBlock Grid.Column="1" Text="✋ Hold &amp; drag to move" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Close / Hide Button -->
                        <Button Grid.Column="2" Content="✕" Click="BtnHide_Click" Background="Transparent" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold" Padding="6,2" BorderThickness="0" Cursor="Hand" ToolTip="Hide to System Tray (Esc)"/>
                    </Grid>
                </Border>

                <!-- Search Input Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Column="0" Background="{StaticResource InputBg}" CornerRadius="6" Padding="10,7" Margin="0,0,8,0" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="txtSearch" Grid.Column="1" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged" PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
                            <TextBlock x:Name="txtSearchPlaceholder" Grid.Column="1" Text="Type to search files, folders, or web links..." Foreground="{StaticResource TextMuted}" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Visible"/>
                        </Grid>
                    </Border>

                    <!-- Add Menu Button -->
                    <Button x:Name="btnAdd" Grid.Column="1" Content="+ Add" Click="BtnAdd_Click" Padding="14,7" Background="{StaticResource AccentBlue}" Foreground="#0F0F17" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Settings Button -->
                    <Button x:Name="btnSettings" Grid.Column="2" Content="⚙ Settings" Click="BtnSettings_Click" Padding="12,7" Background="{StaticResource InputBg}" Foreground="{StaticResource TextMain}" FontSize="13" BorderThickness="1" BorderBrush="{StaticResource CardBorder}" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>

            <!-- Category Filter Bar -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <StackPanel x:Name="pnlCategories" Orientation="Horizontal"/>
            </ScrollViewer>

            <!-- Items Scrollable Container -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="pnlItemsContainer">

                    <!-- FILES SECTION -->
                    <Border x:Name="secFiles" Margin="0,0,0,14" Visibility="Visible">
                        <StackPanel>
                            <TextBlock Text="FILES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="4,0,0,6"/>
                            <ItemsControl x:Name="lstFiles">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="itemBorder" Background="{StaticResource CardBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" BorderBrush="{StaticResource CardBorder}" BorderThickness="1.2"
                                                PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown" PreviewMouseMove="Item_PreviewMouseMove" Cursor="Hand" ToolTip="Click to open or drag OUT to Desktop/Explorer">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TypeIcon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMain}"/>
                                                        <TextBlock Text="{Binding StatusBadge}" Foreground="{StaticResource WarningRed}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="▶ Open" Click="BtnOpen_Click" Tag="{Binding}" Background="{StaticResource AccentBlue}" Foreground="#0F0F17" FontWeight="Bold" Padding="10,5" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                                    <Button Content="📍 Location" Click="BtnLocation_Click" Tag="{Binding}" Background="#2A2A3D" Foreground="{StaticResource TextMain}" Padding="8,5" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                                    <Button Content="🗑" Click="BtnDelete_Click" Tag="{Binding}" Background="Transparent" Foreground="{StaticResource WarningRed}" FontWeight="Bold" Padding="6,5" BorderThickness="0" Cursor="Hand" ToolTip="Remove from Quick Access"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- FOLDERS SECTION -->
                    <Border x:Name="secFolders" Margin="0,0,0,14" Visibility="Visible">
                        <StackPanel>
                            <TextBlock Text="FOLDERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="4,0,0,6"/>
                            <ItemsControl x:Name="lstFolders">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" BorderBrush="{StaticResource CardBorder}" BorderThickness="1.2"
                                                PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown" PreviewMouseMove="Item_PreviewMouseMove" Cursor="Hand" ToolTip="Click to open or drag OUT to Desktop/Explorer">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TypeIcon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMain}"/>
                                                        <TextBlock Text="{Binding StatusBadge}" Foreground="{StaticResource WarningRed}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="▶ Open" Click="BtnOpen_Click" Tag="{Binding}" Background="{StaticResource AccentBlue}" Foreground="#0F0F17" FontWeight="Bold" Padding="10,5" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                                    <Button Content="📍 Location" Click="BtnLocation_Click" Tag="{Binding}" Background="#2A2A3D" Foreground="{StaticResource TextMain}" Padding="8,5" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                                    <Button Content="🗑" Click="BtnDelete_Click" Tag="{Binding}" Background="Transparent" Foreground="{StaticResource WarningRed}" FontWeight="Bold" Padding="6,5" BorderThickness="0" Cursor="Hand" ToolTip="Remove from Quick Access"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- LINKS SECTION -->
                    <Border x:Name="secLinks" Margin="0,0,0,14" Visibility="Visible">
                        <StackPanel>
                            <TextBlock Text="LINKS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="4,0,0,6"/>
                            <ItemsControl x:Name="lstLinks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" BorderBrush="{StaticResource CardBorder}" BorderThickness="1.2"
                                                PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown" PreviewMouseMove="Item_PreviewMouseMove" Cursor="Hand" ToolTip="Click to open or drag URL OUT to Chrome/Notepad">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TypeIcon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMain}"/>
                                                    <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{StaticResource AccentBlue}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="▶ Open" Click="BtnOpen_Click" Tag="{Binding}" Background="{StaticResource AccentBlue}" Foreground="#0F0F17" FontWeight="Bold" Padding="10,5" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                                    <Button Content="📋 Copy Link" Click="BtnCopyLink_Click" Tag="{Binding}" Background="{StaticResource AccentGreen}" Foreground="#0F0F17" FontWeight="Bold" Padding="8,5" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                                    <Button Content="🗑" Click="BtnDelete_Click" Tag="{Binding}" Background="Transparent" Foreground="{StaticResource WarningRed}" FontWeight="Bold" Padding="6,5" BorderThickness="0" Cursor="Hand" ToolTip="Remove from Quick Access"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- EMPTY STATE DISPLAY -->
                    <Border x:Name="pnlEmptyState" Visibility="Collapsed" Padding="30" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="No quick access items found" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Drag and drop files/folders/links here or click '+ Add'" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Drag and Drop Drop-Zone Footer -->
            <Border Grid.Row="3" Background="{StaticResource HeaderBg}" CornerRadius="6" Padding="12,9" Margin="0,10,0,0" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📥" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Drag &amp; drop files/folders/URLs HERE to add" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📤" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Drag any item OUT to Explorer/Desktop" FontSize="11" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
