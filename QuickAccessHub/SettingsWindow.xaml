<Window x:Class="QuickAccessHub.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Access Hub Settings" Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E" Foreground="#CDD6F4"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#F5E0DC"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Settings" FontSize="20" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,20"/>

        <!-- Section 1: Global Shortcut -->
        <Border Grid.Row="1" Background="#181825" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Global Keyboard Shortcut" FontWeight="SemiBold" FontSize="14" Foreground="#A6ADC8" Margin="0,0,0,4"/>
                <TextBlock Text="Press this hotkey from any application to bring up Quick Access Hub." FontSize="12" Foreground="#6C7086" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtHotkeyDisplay" Grid.Column="0" IsReadOnly="True" Text="Ctrl + Space" FontWeight="Bold" FontSize="14" TextAlignment="Center" VerticalAlignment="Center" PreviewKeyDown="TxtHotkeyDisplay_PreviewKeyDown"/>
                    <Button x:Name="btnRecordHotkey" Grid.Column="1" Content="Change Shortcut" Click="BtnRecordHotkey_Click" Margin="10,0,0,0" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"/>
                </Grid>
                <TextBlock x:Name="txtHotkeyStatus" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Section 2: Windows Startup -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <CheckBox x:Name="chkStartWithWindows" Content="Start Quick Access Hub automatically with Windows" FontSize="13" Foreground="#CDD6F4" Click="ChkStartWithWindows_Click"/>
                <TextBlock Text="Runs in the system tray in the background on startup without administrator privileges." FontSize="11" Foreground="#6C7086" Margin="24,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Section 3: Categories -->
        <Border Grid.Row="3" Background="#181825" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Manage Categories" FontWeight="SemiBold" FontSize="14" Foreground="#A6ADC8" Margin="0,0,0,8"/>

                <ListBox x:Name="lstCategories" Grid.Row="1" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Margin="0,0,0,10" DisplayMemberPath="Name"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtNewCategory" Grid.Column="0"/>
                    <Button Content="Add" Click="BtnAddCategory_Click" Grid.Column="1" Margin="8,0,0,0" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold"/>
                    <Button Content="Delete" Click="BtnDeleteCategory_Click" Grid.Column="2" Margin="8,0,0,0" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="4" Content="Done" Click="BtnDone_Click" HorizontalAlignment="Right" Width="100" Margin="0,16,0,0" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"/>
    </Grid>
</Window>
