<Window x:Class="QuickAccessHub.AddEditItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Item" Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E" Foreground="#CDD6F4"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#F5E0DC"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Name="txtDialogTitle" Grid.Row="0" Text="Add Quick Item" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" Foreground="#89B4FA"/>

        <!-- Type Selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Item Type" Margin="0,0,0,6" FontWeight="Medium"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="rbFile" Content="📄 File" IsChecked="True" Checked="Type_Checked"/>
                <RadioButton x:Name="rbFolder" Content="📁 Folder" Checked="Type_Checked"/>
                <RadioButton x:Name="rbUrl" Content="🔗 Web Link" Checked="Type_Checked"/>
            </StackPanel>
        </StackPanel>

        <!-- Display Name -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Display Name" Margin="0,0,0,6" FontWeight="Medium"/>
            <TextBox x:Name="txtName"/>
        </StackPanel>

        <!-- Path / URL -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock x:Name="lblPathOrUrl" Text="File Path" Margin="0,0,0,6" FontWeight="Medium"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtPathOrUrl" Grid.Column="0"/>
                <Button x:Name="btnBrowse" Grid.Column="1" Content="Browse..." Click="BtnBrowse_Click" Margin="8,0,0,0" Padding="12,6" Background="#45475A" Foreground="#CDD6F4" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </StackPanel>

        <!-- Category -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="Category" Margin="0,0,0,6" FontWeight="Medium"/>
            <ComboBox x:Name="cmbCategory" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        </StackPanel>

        <!-- Error Text -->
        <TextBlock x:Name="txtError" Grid.Row="5" Foreground="#F38BA8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- Dialog Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="BtnCancel_Click" Width="90" Height="34" Margin="0,0,10,0" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="btnSave" Content="Save Item" Click="BtnSave_Click" Width="100" Height="34" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
